SQL_SERVER=server_pn
SQL_SERVER_PN=server_pn
SQL_SERVER_PRQ10=serverprq10
SQL_SERVER_AD=serverad
SQL_DATABASE=sismoura
SQL_DATABASE_AD=sismoura_srv
# Unidades que aparecem no seletor (pn, prq10, ad), separadas por vírgula. Vazio = todas.
# A primeira da lista é a unidade padrão. Ex.: FILIAIS_ATIVAS=pn
FILIAIS_ATIVAS=
SQL_USERNAME=sa
SQL_PASSWORD=SENHA_AQUI

CACHE_TTL_SECONDS=120
FLASK_HOST=0.0.0.0
# Porta do sistema (3002 = Metas na tabela de portas do servidor)
PORT=3002
FLASK_DEBUG=false

SQLITE_PATH=data/sistema.db
LOG_PATH=logs/app.log
